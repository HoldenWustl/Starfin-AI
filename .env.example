# Required. You can also run: npm run setup
AI_API_KEY=
GITHUB_TOKEN=
DISCORD_BOT_TOKEN=
STARFIN_TARGET_REPOSITORY=
DISCORD_ALLOWED_USER_IDS=

# Optional. Leave branch empty to use the repository's default branch.
STARFIN_TARGET_BRANCH=
# Set a server ID to register slash commands immediately in that server.
DISCORD_GUILD_ID=
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_NOTIFICATION_CHANNEL_ID=

# OpenAI Chat Completions, or a compatible endpoint with function tool support.
# OPENAI_API_KEY and GH_TOKEN also work as aliases for the two keys above.
AI_MODEL=gpt-4.1
AI_BASE_URL=https://api.openai.com/v1

PORT=4000
# Docker isolates repository commands from this bot's secrets.
# Host mode is available for trusted repositories on a dedicated machine.
STARFIN_EXECUTION_MODE=docker
STARFIN_RUNNER_IMAGE=node:24-bookworm
STARFIN_DATA_DIR=./data
STARFIN_WORKSPACE_ROOT=./workspaces
STARFIN_KEEP_WORKSPACES=false
STARFIN_MAX_STEPS=50
STARFIN_MAX_QUEUE=20
STARFIN_JOB_TIMEOUT_MS=1800000
STARFIN_COMMAND_TIMEOUT_MS=300000

# Prefix commands are optional; require Message Content Intent in Discord.
STARFIN_ENABLE_PREFIX_COMMANDS=false

# Optional push-to-base-branch repair jobs. Not needed for Discord commands.
STARFIN_AUTO_FIX_PUSHES=false
GITHUB_WEBHOOK_SECRET=
